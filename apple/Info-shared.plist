<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Allow the app's own URLSession calls to reach a Plex server on the LAN
       over plain HTTP (local-network address / .local). Xcode merges its
       generated keys (bundle id, version, scene manifest, launch) on top. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- iOS launch screen: the dumbTV dark field (ignored on tvOS/macOS). -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key>
    <string>LaunchBackground</string>
  </dict>
</dict>
</plist>
